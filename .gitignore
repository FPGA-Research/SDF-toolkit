# Byte-compiled / optimized
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Test / coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
coverage.xml

# Environments
.env
.venv

# Type checkers
.mypy_cache/

# IDE
.idea
.vscode

# Generated files
parsetab.py
parser.out

# Sphinx documentation
docs/_build/

# Local shell, git and agent files that live in the checkout root.
# Anchored to the root so that names like `config` and `hooks` do not hide
# package subdirectories.
/.z*
/.bash*
/.profile
/.gitconfig
/.gitmodules
/.mcp.json
/.ripgreprc
/.claude
/HEAD
/hooks
/objects
/refs
/config
