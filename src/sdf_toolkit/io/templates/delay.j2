{%- if absolute or increment %}
        (DELAY
    {%- if absolute %}
            (ABSOLUTE
        {%- for line in absolute %}
                {{ line }}
        {%- endfor %}
            )
    {%- endif %}
    {%- if increment %}
            (INCREMENT
        {%- for line in increment %}
                {{ line }}
        {%- endfor %}
            )
    {%- endif %}
        )
{%- endif -%}
