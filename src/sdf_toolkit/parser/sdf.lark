// SDF grammar for the Lark LALR(1) parser, after OVI SDF 3.0 (May 1995) and
// P1497 Draft 0.10, which calls itself SDF 4.0.
// The parser is built with strict=True, so a shift/reduce conflict or two
// colliding terminals of equal priority fail the build.

sdf_file: "(" DELAYFILE sdf_item* ")"

// Fragments of a file, for parsing one chunk of a split file on its own.
// head is a file up to its first cell, so it is deliberately unterminated;
// body is a run of whole items cut out from between two cells; tail is the
// parenthesis closing the file.
head: "(" DELAYFILE sdf_item*
body: sdf_item*
tail: ")"

sdf_item: sdf_header_item | cell | include

sdf_header_item: sdf_version
               | design
               | date
               | vendor
               | program
               | version
               | hierarchy_divider
               | voltage
               | process
               | temperature
               | timescale

sdf_version: "(" "SDFVERSION" QSTRING ")"
design: "(" "DESIGN" [QSTRING] ")"
date: "(" "DATE" [QSTRING] ")"
vendor: "(" "VENDOR" [QSTRING] ")"
program: "(" "PROGRAM" [QSTRING] ")"
version: "(" "VERSION" [QSTRING] ")"
process: "(" "PROCESS" [QSTRING] ")"

voltage: "(" "VOLTAGE" (real_triple | rvalue) ")"

temperature: "(" "TEMPERATURE" (real_triple | rvalue) ")"

hierarchy_divider: "(" "DIVIDER" (DOT | SLASH) ")"

timescale: "(" "TIMESCALE" FLOAT STRING ")"

// Cell definitions
cell: "(" "CELL" celltype instance _timing_spec* ")"

_timing_spec: timing_check | delay | timingenv | label | include

// SDF 1.0 INCLUDE, read only to reject it with a clear error.
include: "(" "INCLUDE" QSTRING ")"

// LABEL sets the value of a model variable, such as a specparam.  The
// keywords that only one standard defines are named terminals, so the
// transformer has their position for the error.
label: "(" LABEL _label_type+ ")"

_label_type: label_absolute | label_increment

label_absolute: "(" "ABSOLUTE" label_def+ ")"

label_increment: "(" "INCREMENT" label_def+ ")"

label_def: "(" STRING delval_list ")"

celltype: "(" "CELLTYPE" QSTRING ")"

instance: "(" "INSTANCE" [STRING | ASTERISK] ")"

// Timing checks
timing_check: "(" "TIMINGCHECK" timing_check_list ")"

timing_check_list: t_check+

t_check: removal_check | recovery_check | hold_check | setup_check | width_check
       | period_check | setuphold_check | recrem_check | skew_check
       | bidirectskew_check | nochange_check

removal_check: "(" "REMOVAL" timing_port timing_port rvalue ")"

recovery_check: "(" "RECOVERY" timing_port timing_port rvalue ")"

hold_check: "(" "HOLD" timing_port timing_port rvalue ")"

setup_check: "(" "SETUP" timing_port timing_port rvalue ")"

width_check: "(" "WIDTH" timing_port rvalue ")"

period_check: "(" "PERIOD" timing_port rvalue ")"

setuphold_check: "(" "SETUPHOLD" timing_port timing_port rvalue rvalue [scond] [ccond] ")"

recrem_check: "(" "RECREM" timing_port timing_port rvalue rvalue [scond] [ccond] ")"

skew_check: "(" "SKEW" timing_port timing_port rvalue ")"

// BIDIRECTSKEW exists in P1497 Draft 0.10 only, not in OVI SDF 3.0.
bidirectskew_check: "(" BIDIRECTSKEW timing_port timing_port rvalue rvalue ")"

nochange_check: "(" "NOCHANGE" timing_port timing_port rvalue rvalue ")"

// The stamp and check event conditions of SETUPHOLD and RECREM.
scond: "(" "SCOND" [QSTRING] equation ")"
ccond: "(" "CCOND" [QSTRING] equation ")"

// The QSTRING names the condition (IEEE 1497 port_tchk).
timing_port: port_spec | "(" COND [QSTRING] equation port_spec ")"

// Timing environment
timingenv: "(" "TIMINGENV" constraints_list ")"

constraints_list: _te_def+

_te_def: path_constraint | period_constraint | skew_constraint | arrival | departure
       | slack | waveform

path_constraint: "(" "PATHCONSTRAINT" [constraint_name] port_spec port_spec+ rvalue rvalue ")"

constraint_name: "(" "NAME" [QSTRING] ")"

period_constraint: "(" "PERIODCONSTRAINT" STRING rvalue [exception] ")"

exception: "(" "EXCEPTION" instance+ ")"

skew_constraint: "(" "SKEWCONSTRAINT" port_spec rvalue ")"

arrival: "(" "ARRIVAL" [port_edge] STRING rvalue rvalue rvalue rvalue ")"

departure: "(" "DEPARTURE" [port_edge] STRING rvalue rvalue rvalue rvalue ")"

// The bare number is the clock period the slack was found at.
slack: "(" "SLACK" STRING rvalue rvalue rvalue rvalue [FLOAT] ")"

waveform: "(" "WAVEFORM" STRING FLOAT wave_edge+ ")"

wave_edge: "(" (POSEDGE | NEGEDGE) FLOAT ")"
         | "(" (POSEDGE | NEGEDGE) FLOAT FLOAT ")"

// Delay section: a DELAY holds any mix of ABSOLUTE and INCREMENT blocks and
// the PATHPULSE and PATHPULSEPERCENT deltypes, which have no mode.
delay: "(" "DELAY" _deltype+ ")"

_deltype: absolute | increment | path_pulse | path_pulse_percent

path_pulse: "(" "PATHPULSE" _pulse_body ")"

path_pulse_percent: "(" "PATHPULSEPERCENT" _pulse_body ")"

// The input and output port name the path; without them the entry covers
// every IOPATH of the cell.
_pulse_body: (STRING STRING)? _paren_rvalue _paren_rvalue?

absolute: "(" "ABSOLUTE" _delay_def+ ")"

increment: "(" "INCREMENT" _delay_def+ ")"

_delay_def: _plain_delay | cond_delay | condelse_delay

// A condition wraps plain entries only, so a nested COND is a syntax error.
// Both standards allow one IOPATH; the transformer applies that rule unless
// the parse takes a loose COND.
_plain_delay: iopath | port | interconnect | device | netdelay

cond_delay: "(" COND [QSTRING] equation _plain_delay+ ")"

condelse_delay: "(" CONDELSE _plain_delay+ ")"

// A delval is an rvalue, or an rvalue grouped with its pulse rejection
// limit and its X limit: ((delay) (r-limit) [(e-limit)]).
delval_list: _delval+

_delval: rvalue | pulse_delval

// An optional inlined rule leaves no None placeholder, so each arity is
// its own alternative.
pulse_delval: "(" _paren_rvalue _paren_rvalue ")"
            | "(" _paren_rvalue _paren_rvalue _paren_rvalue ")"

// port_instance positions take no edge, so they read a bare STRING.
device: "(" "DEVICE" [STRING] delval_list ")"

iopath: "(" "IOPATH" port_spec STRING retain* delval_list ")"

// RETAIN reads its delvals unpadded, so IEEE 1497 can limit their count.
retain: "(" RETAIN _delval+ ")"

netdelay: "(" NETDELAY STRING delval_list ")"

interconnect: "(" "INTERCONNECT" STRING STRING delval_list ")"

port: "(" "PORT" STRING delval_list ")"

port_spec: STRING | port_edge

port_edge: "(" (POSEDGE | NEGEDGE | EDGE_TRANSITION) STRING ")"

// A bare number is the VOLTAGE and TEMPERATURE value form.
?rvalue: rvalue_number | _paren_rvalue

_paren_rvalue: "(" rvalue_number ")"
             | "(" real_triple ")"
             | empty_rvalue

empty_rvalue: "(" ")"

rvalue_number: FLOAT

// A triple holds at least one number, so (::) is not one.
real_triple: FLOAT ":" [FLOAT] ":" [FLOAT]
           | ":" FLOAT ":" [FLOAT]          -> triple_from_typ
           | ":" ":" FLOAT                  -> triple_max_only

// Equations alternate operand and binary operator, so two adjacent operands
// end the equation: in (COND en d) the name d is the port, not part of it.
equation: _eq_term (_binary_op _eq_term)*

_eq_term: _unary_op* _eq_atom

_eq_atom: STRING | EQNUMBER | SCALARCONSTANT | eq_group

eq_group: "(" equation ")"

_unary_op: PLUS | MINUS | LOGIC_NOT | BIT_NOT | BIT_AND | NAND | BIT_OR | NOR
         | XOR | XNOR

_binary_op: PLUS | MINUS | ASTERISK | SLASH | MODULO | LOGIC_AND | BIT_AND
          | LOGIC_OR | BIT_OR | XOR | XNOR | EQUAL | NEQUAL | CASEEQUAL
          | CASENEQUAL | LEFTSHIFT | RIGHTSHIFT | GT | LT | GTE | LTE

// Keywords
DELAYFILE: "DELAYFILE"
LABEL: "LABEL"
NETDELAY: "NETDELAY"
BIDIRECTSKEW: "BIDIRECTSKEW"
RETAIN: "RETAIN"
POSEDGE: "posedge"
NEGEDGE: "negedge"
// The six single-transition edge identifiers of IEEE 1497 port_edge.
EDGE_TRANSITION: "01" | "10" | "0z" | "z1" | "1z" | "z0"
// A string literal has no word boundary, so "COND" would match the head of
// CONDELSE and leave ELSE to be read as an equation.  interegular cannot
// model \b, so strict mode does not check these two for collisions.
COND.2: /COND\b/
CONDELSE.2: /CONDELSE\b/

// Operators
PLUS: "+"
MINUS: "-"
MODULO: "%"
LOGIC_NOT: "!"
BIT_NOT: "~"
LOGIC_AND: "&&"
BIT_AND: "&"
NAND: "~&"
LOGIC_OR: "||"
BIT_OR: "|"
NOR: "~|"
XOR: "^"
XNOR: "~^" | "^~"
EQUAL: "=="
NEQUAL: "!="
CASEEQUAL: "==="
CASENEQUAL: "!=="
LEFTSHIFT: "<<"
RIGHTSHIFT: ">>"
GT: ">"
GTE: ">="
LT: "<"
LTE: "<="

DOT: "."
SLASH: "/"
ASTERISK: "*"

FLOAT.1: /[-+]?(?:[0-9]+\.?[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?/
SCALARCONSTANT.3: /[01]?'[bB][01]/
// Numbers inside a condition keep their original text (see equation).
EQNUMBER.2: /[-+]?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/
// IEEE 1497 lets a backslash escape the next character, so \" does not end
// the string.  OVI SDF 3.0 has no escape, and the transformer rejects \" there.
QSTRING: /"(?:[^"\\]|\\[\s\S])*"/
// A backslash escapes the character after it, so u\(1\) is one identifier.
// The bit range alternative comes first so a[3:0] is one identifier and a
// colon outside brackets still ends it.
STRING: /(?:\[[0-9]+:[0-9]+\]|[a-zA-Z0-9_\/.\[\]$]|\\\S)+/

%import common.WS
%ignore WS
// Both comments take priority over STRING, which also matches a slash.
COMMENT.1: /\/\/[^\n]*/
%ignore COMMENT
BLOCK_COMMENT.1: /\/\*[\s\S]*?\*\//
%ignore BLOCK_COMMENT
